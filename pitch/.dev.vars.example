SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace_with_project_publishable_key
DEMO_API_SECRET=replace_with_generated_demo_api_secret
DEMO_OPERATOR_TOKEN=replace_with_generated_operator_passcode_or_token
DEMO_MODE=true
# Inbound-only AI SMS demo. Keep disabled until carrier approval and a tester
# explicitly agrees. No reminders or background sends are enabled by these keys.
SMS_MODE=disabled
SMS_CARRIER_APPROVED=false
SMS_PUBLIC_ORIGIN=https://res.beareberly.com
SMS_TEST_ALLOWLIST=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+12097094194
OPENAI_API_KEY=
# Fast Responses API model supporting strict Structured Outputs.
SMS_AI_MODEL=gpt-4.1-mini
# Allows operator-authenticated, paid AI interpretation with no SMS or DB writes.
SMS_AI_REHEARSAL_ENABLED=false
